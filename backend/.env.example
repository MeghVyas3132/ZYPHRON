# Database
DATABASE_URL=postgresql://zyphron:zyphron@localhost:5432/zyphron
DATABASE_ECHO=False

# Application
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-here

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Redis (for background tasks)
REDIS_URL=redis://localhost:6379/0

# Docker
DOCKER_HOST=unix:///var/run/docker.sock
CONTAINER_REGISTRY=docker.io

# Email (for notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SENDER_EMAIL=noreply@zyphron.space

# Application URLs
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Deployment
DEPLOYMENT_DIR=/app/deployments
TEMP_BUILD_DIR=/tmp/zyphron-builds
MAX_REPO_SIZE_MB=1000
DEPLOYMENT_TIMEOUT_SECONDS=3600

# Monitoring
ENABLE_MONITORING=True
HEALTH_CHECK_INTERVAL=30
UPTIME_CHECK_INTERVAL=60

# Nginx
NGINX_CONFIG_DIR=/etc/nginx/sites-available
MAIN_DOMAIN=zyphron.space
MAIN_DOMAIN_IP=your-server-ip

# SSL/TLS
CERTBOT_EMAIL=admin@zyphron.space
SSL_CERT_DIR=/etc/letsencrypt/live

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/zyphron/backend.log
